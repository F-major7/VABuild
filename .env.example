# Copy this file to:
# - .env (for pizza_agent.py)
# - voice_agent/.env (for voice_agent/main.py)
#
# Fill in all values before running.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

DEEPGRAM_API_KEY=
OPENAI_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Public HTTPS URL that Twilio can reach (e.g. ngrok URL)
BASE_URL=https://xxxx.ngrok.io

# Used by voice_agent/config.py today
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
